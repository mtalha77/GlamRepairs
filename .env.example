# Copy to .env and fill in real values. Do not commit .env.

# Public site URL (used for absolute links if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp business number — digits only, country code included (no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Server only — never expose in the browser (lead insert + photo upload)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public Storage bucket for assessment photos (create in Supabase → Storage)
SUPABASE_PHOTOS_BUCKET=assessment-photos

# Protects /api/cron/cleanup-photos (photos auto-delete after 30 days; lead data stays)
CRON_SECRET=a-long-random-string

# Studio dashboard — first signed-in account with this email becomes owner
STUDIO_OWNER_EMAIL=owner@example.com

# Resend — contact form (company + user thank-you) and funnel plan thank-you
# Bare email is fine; app sends as: GlamRepairs <hello@glamrepairs.com>
RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=hello@glamrepairs.com
CONTACT_TO_EMAIL=glamrepairs@gmail.com

# Gift programme — OFF unless this is exactly "true". Keep it off until there
# is more than one practitioner; gifted assessments spend the same capacity
# paying clients are waiting on.

# Air quality pages (/air-quality, /air-quality/lahore). Unset = the routes
# 404 and are omitted from the sitemap, which is deliberate: without a live
# reading a city page is a templated doorway page.
#
# ⚠️ OpenWeather, not Open-Meteo. Open-Meteo's free API is non-commercial
# only; OpenWeather's free tier permits commercial use under the ODbL, with
# mandatory visible attribution on the page showing the data (already
# rendered by the city page — do not remove it).
# Free key: https://openweathermap.org/api/air-pollution
OPENWEATHER_API_KEY=
